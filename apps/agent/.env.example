# Copy to .env.local (gitignored) and source it, or export these before uvicorn.
# Every value below is real for the 6 Aug 2026 workshop account and expires with it.

# --- backends -----------------------------------------------------------------
# fake/sample run with no AWS at all. Flip one at a time if something breaks.
SAP_BACKEND=mcp             # fake | mcp
EXTRACT_BACKEND=bedrock     # sample | bedrock
JUDGE_BACKEND=bedrock       # fake | bedrock
STORAGE_BACKEND=s3          # fake | s3. `fake` records moves without calling S3.

# --- AWS ----------------------------------------------------------------------
# Credentials come from the standard chain. Locally: AWS_PROFILE=workshop, using
# the [workshop] block in ~/.aws/credentials from Workshop Studio -> "Get AWS CLI
# credentials". They expire when the event does; re-copy them if calls start
# failing with ExpiredToken.
AWS_PROFILE=workshop
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=516359819848

# --- SAP ----------------------------------------------------------------------
# Host comes from the WebGuiURL in Workshop Studio -> Event outputs, with the
# /sap/bc/gui/... path swapped for the OData base path.
SAP_BASE_URL=https://sap-workshop-720f09b6b2563946.events.sap.aws.dev/sap/opu/odata/sap

# --- MCP server on AgentCore --------------------------------------------------
# Printed by deploy_mcp_server.py and stored in SSM at
# /sap_mcp_server/runtime/agent_arn. Set it explicitly here because the workshop
# participant role cannot read SSM; the code falls back to SSM when it can.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:516359819848:runtime/sap_mcp_server_1786023560-PTTQ1n8Y2J

# The Cognito client id and secret are NOT here on purpose. They are read at
# runtime from Secrets Manager (sap_mcp_server/cognito/oauth2_config), written by
# setup_cognito.py. Nothing needs them in a file.

# --- Bedrock ------------------------------------------------------------------
# Sonnet 5 and Opus 5 appear in list-inference-profiles but Converse returns
# AccessDenied on this account. 4.6 is the newest that actually works.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- invoice buckets ----------------------------------------------------------
# An invoice has a life: it lands in UPLOAD_BUCKET, and once a human has decided
# it moves to one of the two archives. Whatever is left in UPLOAD_BUCKET is
# exactly what still needs attention.
#
# From Workshop Studio -> Event outputs -> InvoiceBucketName. Holds the six
# workshop PDFs, which `Load batch` reads. Never written to and never emptied -
# deleting one destroys the demo fallback for the whole account.
INVOICE_BUCKET=516359819848-invoice

# Where the browser PUTs dropped PDFs. Needs a CORS rule allowing PUT from the
# web app's origin, or the browser blocks the upload; already configured for
# localhost:3000, 127.0.0.1:3000 and *.vercel.app.
UPLOAD_BUCKET=516359819848-uploaded-invoice

# Parked in SAP.
PROCESSED_BUCKET=516359819848-processed-invoice

# Turned down by a person. An invoice the checks blocked but nobody ruled on
# stays in UPLOAD_BUCKET instead - no verdict was reached.
BLOCKED_BUCKET=516359819848-blocked-invoice

# Bedrock Knowledge Base over the -sops bucket, holding docs/sops/. Without it the
# price-tolerance check falls back to a flat 5% and says so; with it, rule 9 reads
# the tiered policy and cites the document. Rebuild with scripts/make_kb.py.
SOP_KNOWLEDGE_BASE_ID=NKB8KVAZ45

# --- HTTP ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
