# Copy to .env.local (gitignored).

# --- the orchestrator ---------------------------------------------------------
# Unset  -> the frontend replays the scripted mock, no backend needed.
# Set    -> /api/chat and /api/approve proxy to apps/agent.
AGENT_ENDPOINT=http://localhost:8000

# Only if the orchestrator is deployed behind an authenticating gateway. Not
# needed when it runs locally.
AGENT_TOKEN=

# Forces the mock even when AGENT_ENDPOINT is set. This is the demo fallback:
# if SAP or the venue network dies, set MOCK=1 and the run still plays.
MOCK=

# --- direct-to-S3 upload ------------------------------------------------------
# Used only by /api/upload to presign PUT URLs, so invoice PDFs go straight to
# S3 rather than through this server. Needs AWS credentials in the standard
# chain (locally: AWS_PROFILE=workshop).
AWS_REGION=us-east-1

# Dropped PDFs land here. The agent reads them out again, and files each one to
# -processed-invoice or -blocked-invoice once the batch is approved, so what
# remains in this bucket is what still needs attention.
UPLOAD_BUCKET=516359819848-uploaded-invoice

# The bucket needs a CORS rule allowing PUT from this origin, or the browser
# blocks the upload. The workshop stack does not create one - see
# contract/events.md for the rule. Already applied to the bucket above.

# --- SOP manager ----------------------------------------------------------
# Read/write/edit access to the AP SOP documents that feed the price-tolerance
# knowledge base (SOP_KNOWLEDGE_BASE_ID below). Same AWS credential chain as
# the invoice upload above.
SOP_BUCKET=516359819848-sops

# From Workshop Studio / apps/agent/.env.example's value for the same knowledge
# base. Needed to trigger a re-index after editing or uploading a SOP file.
SOP_KNOWLEDGE_BASE_ID=NKB8KVAZ45
