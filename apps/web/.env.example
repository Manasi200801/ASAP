# Copy to .env.local (gitignored).

# --- the orchestrator ---------------------------------------------------------
# Unset  -> the frontend replays the scripted mock, no backend needed.
# Set    -> /api/chat and /api/approve proxy to apps/agent.
AGENT_ENDPOINT=http://localhost:8000

# Only if the orchestrator is deployed behind an authenticating gateway. Not
# needed when it runs locally.
AGENT_TOKEN=

# Forces the mock even when AGENT_ENDPOINT is set. This is the demo fallback:
# if SAP or the venue network dies, set MOCK=1 and the run still plays.
MOCK=

# --- direct-to-S3 upload ------------------------------------------------------
# Used only by /api/upload to presign PUT URLs, so invoice PDFs go straight to
# S3 rather than through this server. Needs AWS credentials in the standard
# chain (locally: AWS_PROFILE=workshop).
AWS_REGION=us-east-1
INVOICE_BUCKET=516359819848-invoice

# The bucket needs a CORS rule allowing PUT from this origin, or the browser
# blocks the upload. The workshop stack does not create one - see
# contract/events.md for the rule.
